{
  "name": "rust-vue-canvas-game-lobby",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist android/app/src/main/assets/public android/app/build",
    "build": "rm -rf dist && vite build",
    "cap:clean": "rm -rf dist android/app/src/main/assets/public",
    "cap:sync": "rm -rf android/app/src/main/assets/public && cap sync android",
    "cap:build": "npm run clean && vite build && cap sync android",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "generate:shortcuts": "node scripts/generate_shortcuts.js",
    "lint": "tsc --noEmit"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "dependencies": {
    "@rollup/wasm-node": "^4.64.10",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3",
    "lucide-vue-next": "^0.475.0",
    "tsx": "^4.19.2",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^4.17.21",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
