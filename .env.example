# Telegram Bot 与服务器端口配置文件 (.env)
# 存放在 Termux 根目录 ~/.env、Serv00 根目录 ~/.env 或项目根目录 .env 均可

# 1. 网页服务器端口 (Termux 推荐 8080；Serv00 填面板申请分配给您的端口，如 32415)
PORT=8080

# 2. Telegram 机器人 ID
BOT_ID="7890123456"

# 3. Telegram 机器人 Token (向 @BotFather 创建并获取，注意带冒号)
BOT_TOKEN="7890123456:AAFdExampleTokenForChuDaDiBot"

# 4. 单 Bot 模式开关 (Single Bot Mode)
# - Serv00 (云端常驻 7x24h): 设为 true，常驻拉取 TG 消息
# - Termux (手机游戏节点): 设为 false，休眠 TG 轮询，避免与云端争抢 409 Conflict
ENABLE_TG_BOT=true

# 5. 双机数据双向同步配置 (Bi-directional Sync)
# 节点角色: serv00_cloud (云端) 或 termux_local (手机端)
NODE_ROLE="serv00_cloud"
NODE_NAME="Serv00-Cloud-Master"

# 对端服务器地址 (Termux 端填写 Serv00 的公网域名或 IP 端口，例如 https://username.serv00.net)
SYNC_REMOTE_URL=""

# 双机通信认证密钥 (两端必须保持完全一致，防止未经授权的同步操作)
SYNC_SECRET_KEY="chudadi_sync_secret_8888"

# 6. Cloudflare Tunnel 隧道 Token (选填，在 Cloudflare Zero Trust 控制台创建)
# 如果配置了此 Token，Cloudflare Tunnel 将绑定你的固定自定义域名；若留空则自动启动免费临时域名穿透
CLOUDFLARE_TUNNEL_TOKEN=""


