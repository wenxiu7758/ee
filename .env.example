# ==============================================================================
# 🀄 国粹棋牌全功能服务 - 环境变量配置文件 (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 游戏服务器公网域名 / Telegram Webhook 回调地址 (核心：APK 与 Bot Webhook 直连)
# ------------------------------------------------------------------------------
# 💡 手机安装的 APK 与 Telegram 官方服务器将通过此 HTTPS 域名连接本服务！
# 自动生成的回调入口: ${URL}/api/telegram/webhook
# 示例: URL="https://your-domain.run.app" 或 URL="https://game.trycloudflare.com"
URL="https://your-server-domain.com"

# ------------------------------------------------------------------------------
# 2. Telegram API 官方海外反代端点 (可选，仅当国内服务器无法直连 api.telegram.org 时配置)
# ------------------------------------------------------------------------------
# 留空则默认直连官方 https://api.telegram.org
# 示例: TELEGRAM_API_BASE="https://api.telegram-proxy.com"
TELEGRAM_API_BASE=""

# ------------------------------------------------------------------------------
# 3. Telegram Bot 机器人 Token
# ------------------------------------------------------------------------------
# 在 Telegram 搜索 @BotFather 发送 /newbot 创建机器人获取到的 Token
# 示例: TELEGRAM_BOT_TOKEN="7123456789:AAHxyzABCDEFGHIJKLMNopqrstuvwxyz"
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------------------
# 4. 管理员 Telegram 用户名 (无需 @ 符号，多个用逗号隔开)
# ------------------------------------------------------------------------------
# 提示: 茶客手机号白名单直接在 Telegram Bot 中向 Bot 发送手机号进行秒级实时白名单授权，无需在环境变量中维护手机号
# 示例: ADMIN_USERNAMES="my_tg_username,boss_account"
ADMIN_USERNAMES="admin_username"

# ------------------------------------------------------------------------------
# 5. 运行模式 (默认纯 Webhook 模式，杜绝死循环轮询与 409 Conflict)
# ------------------------------------------------------------------------------
# • "webhook" (推荐，只用 Webhook！0延迟即时推送，免代理直接回复，零轮询冲突)
# • "polling" (仅在无公网域名的离线/内网 Termux 环境下备用)
BOT_MODE="webhook"
WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. 服务运行端口与主机绑定
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
